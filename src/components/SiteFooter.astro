---
// Peu comú de Fase 1: Contacte · Avís legal · Privacitat · Cookies · ©.
// Una pàgina legal només s'enllaça quan el contingut la marca com a publicable.
import { company } from '../config/site';
import BrandLogo from './BrandLogo.astro';
import type { Locale } from '../i18n/config';
import { getPage } from '../i18n/pages';
import type { UiStrings } from '../i18n/ui';

interface Props {
  ui: UiStrings;
  locale: Locale;
  contactHref: string;
  variant?: 'serralleria' | 'industrial';
}

const { ui, locale, contactHref, variant = 'serralleria' } = Astro.props;

const legal = await Promise.all(
  (Object.entries(ui.footer.legal) as [string, string][]).map(async ([pageId, label]) => {
    const { data } = await getPage(pageId, locale);
    const published = data.status === 'approved' && data.publishReady !== false;
    return { label, href: published ? data.route : undefined };
  }),
);
---

<footer class="site-footer" data-surface="dark">
  <div class="footer-inner">
    <div class="footer-brand">
      <BrandLogo variant={variant} place="footer" /><small>{ui.brand.tagline}</small>
    </div>
    <ul class="footer-links">
      <li><a href={contactHref}>{ui.footer.contact}</a></li>
      {
        legal.map(({ label, href }) => (
          <li>{href ? <a href={href}>{label}</a> : <span>{label} <small>({ui.footer.pending})</small></span>}</li>
        ))
      }
      <li><span>© {company.legalName}</span></li>
    </ul>
    <a class="back-top" href="#inici">{ui.footer.backTop} <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .site-footer {
    background: #0d0e10;
    color: var(--f4-text);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    width: min(100%, 1600px);
    min-height: 190px;
    margin-inline: auto;
    padding: 3.5rem var(--page-gutter);
  }

  .footer-brand {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-brand small {
    margin-top: 1rem;
    color: #bac0c0;
    font-size: 0.83rem;
    line-height: 1.3;
    text-transform: none;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    max-width: 35ch;
    color: #b4b9ba;
    font-size: 0.84rem;
  }

  .footer-links a,
  .footer-links span {
    display: flex;
    align-items: center;
    gap: 0.3em;
    min-height: var(--target-min);
  }

  .footer-links a {
    color: #fff;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .back-top {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--target-min);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (min-width: 761px) {
    .footer-links {
      flex-direction: row;
      flex-wrap: wrap;
      column-gap: 1.5rem;
      max-width: 60ch;
    }
  }

  @media (min-width: 1001px) {
    .footer-links {
      max-width: none;
    }
  }

  @media (max-width: 520px) {
    .footer-inner {
      flex-direction: column;
    }
  }
</style>
