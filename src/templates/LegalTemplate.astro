---
// Plantilla de pàgina legal (Fase 8, tasca 8.3): avís legal, privacitat i cookies. Fase 1: «Els
// tres textos legals se separen en pàgines pròpies». El text el redacta o valida el client o
// l'assessor (CLAUDE.md: no s'inventen textos legals) i viu a content/{idioma}/legal-*.md; la
// plantilla només el presenta: entrada fosca amb la H1, índex de seccions i cos de lectura.
// Accepta Markdown complet (taules per a l'inventari de cookies, llistes, enllaços).
// Publicació: src/pages/legal/[page].astro només genera les pàgines aprovades; en desenvolupament
// també mostra els esborranys, amb un avís visible, perquè el director pugui revisar el disseny.
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { Page } from '../i18n/pages';
import { useUi } from '../i18n/ui';
import './mockup-base.css';

interface Props {
  page: Page;
  /** Altres pàgines legals que es generen en aquest build (per a l'enllaç entre elles). */
  siblings: { label: string; href: string; current: boolean }[];
}

const { page, siblings } = Astro.props;
const { lang: locale, pageId, status, publishReady, requiredSource } = page.data;
const ui = useUi(locale);
const t = ui.legal;
const { Content, headings } = await render(page);

// Títol: la H1 del contingut; si encara no n'hi ha (text pendent), l'etiqueta del peu.
const title = headings.find((heading) => heading.depth === 1)?.text ?? ui.footer.legal[pageId as keyof typeof ui.footer.legal] ?? pageId;
const sections = headings.filter((heading) => heading.depth === 2);
const isDraft = status !== 'approved' || publishReady === false;
// En revisió jurídica: visible a la web amb avís (publishReady: true); esborrany: només en desenvolupament.
const inReview = isDraft && publishReady === true;
// Un text no es pot aprovar mentre tingui dades pendents marcades «[PENDENT: …]».
if (status === 'approved' && (page.body ?? '').includes('[PENDENT')) {
  throw new Error(`${pageId}.md està aprovat però encara té dades «[PENDENT: …]».`);
}
const hasBody = headings.length > 0 || (page.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim().length > 0;
const updated = page.data.updated
  ? new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric' }).format(page.data.updated)
  : undefined;
const chars = Math.max(...title.split(/\s+/).map((word) => word.length));
---

<BaseLayout page={page} surface="dark">
  <SiteHeader ui={ui} homeHref="/" nav={ui.home.nav} mobileExtra={ui.home.mobileExtra} />

  <main id="contingut" class="legal-page">
    <section class="legal-hero" aria-labelledby="legal-title">
      <div class="section-shell legal-hero-inner">
        <nav class="legal-crumb enter" aria-label={ui.service.breadcrumb.label}>
          <a href="/">{ui.service.breadcrumb.home}</a><span aria-hidden="true">/</span><span>{t.crumb}</span>
        </nav>
        <h1 id="legal-title" class="enter" style={`--i:1;--chars:${chars}`}>{title}</h1>
        {updated && <p class="legal-updated enter" style="--i:2">{t.updated}: {updated}</p>}
      </div>
    </section>

    {
      isDraft && (
        <aside class="legal-draft" role="note">
          <div class="section-shell">
            <strong>{inReview ? t.review.title : t.draft.title}</strong>
            <p>{inReview ? t.review.text : t.draft.text}</p>
            {!inReview && requiredSource && <p class="legal-draft-source">{requiredSource}</p>}
          </div>
        </aside>
      )
    }

    <div class="section-shell legal-layout" data-surface="light">
      {
        (sections.length > 1 || siblings.length > 1) && (
          <aside class="legal-aside">
            {sections.length > 1 && (
              <nav class="legal-toc" aria-label={t.toc}>
                <span>{t.toc}</span>
                <ol>
                  {sections.map((section) => (
                    <li>
                      <a href={`#${section.slug}`}>{section.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            )}
            {siblings.length > 1 && (
              <nav class="legal-others" aria-label={t.others}>
                <span>{t.others}</span>
                <ul>
                  {siblings.map((sibling) => (
                    <li>
                      {sibling.current ? (
                        <span aria-current="page">{sibling.label}</span>
                      ) : (
                        <a href={sibling.href}>{sibling.label}</a>
                      )}
                    </li>
                  ))}
                </ul>
              </nav>
            )}
          </aside>
        )
      }
      <article class="legal-body">
        {hasBody ? <Content /> : <p class="legal-empty">{t.empty}</p>}
      </article>
    </div>
  </main>

  <SiteFooter ui={ui} locale={locale} contactHref="/contacte/" />
</BaseLayout>

<style>
  .legal-page {
    background: var(--surface-read);
    color: var(--color-ink, #202124);
  }

  /* Entrada fosca com a la resta d'interiors, més baixa: la pàgina és de lectura. */
  .legal-hero {
    background: var(--surface-dark);
    color: #fff;
  }

  .legal-hero-inner {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .legal-crumb {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 44px;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.28);
    color: #e6e8e7;
    font-size: 0.81rem;
    font-weight: 600;
  }

  .legal-crumb a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .legal-crumb > span[aria-hidden] {
    color: var(--f4-muted);
  }

  h1 {
    max-width: 18ch;
    margin: 0;
    font-size: var(--type-hero);
    font-weight: 700;
    letter-spacing: -0.07em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .legal-updated {
    margin: 1.2rem 0 0;
    color: #c9cecc;
    font-size: var(--type-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  /* Avís d'esborrany: només es veu en desenvolupament, perquè el build no genera esborranys. */
  .legal-draft {
    border-block: 1px solid #c79a9e;
    background: #f7eeee;
    color: #3a1418;
  }

  .legal-draft .section-shell {
    padding-block: 1rem;
  }

  .legal-draft strong {
    display: block;
    color: #7c2a30;
  }

  .legal-draft p {
    max-width: 80ch;
    margin: 0.3rem 0 0;
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .legal-draft-source {
    color: #5b3a3d;
    font-style: italic;
  }

  .legal-layout {
    display: grid;
    grid-template-columns: minmax(200px, 0.32fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 6rem);
    padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(3.5rem, 6vw, 6rem);
  }

  .legal-aside {
    position: sticky;
    top: 100px;
    display: grid;
    gap: 2rem;
  }

  .legal-aside nav > span {
    display: block;
    margin-bottom: 0.6rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #d3d9d5;
    color: #7c2a30;
    font-size: var(--type-meta);
    font-weight: 700;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
  }

  .legal-aside ol,
  .legal-aside ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legal-aside a,
  .legal-aside [aria-current] {
    display: flex;
    align-items: center;
    min-height: 40px;
    color: #2f3533;
    font-size: 0.94rem;
    line-height: 1.3;
    text-decoration: none;
  }

  .legal-aside a:hover {
    color: #7c2a30;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .legal-aside [aria-current] {
    color: #7c2a30;
    font-weight: 700;
  }

  /* Cos de lectura: una columna estreta i ritme de text llarg. */
  .legal-body {
    grid-column: 2;
    min-width: 0;
    max-width: 72ch;
    font-size: 1.06rem;
    line-height: 1.65;
  }

  .legal-layout:not(:has(.legal-aside)) .legal-body {
    grid-column: 1 / -1;
  }

  /* La H1 del contingut ja és a l'entrada. */
  .legal-body :global(h1) {
    display: none;
  }

  .legal-body :global(h2) {
    margin: 2.6rem 0 0.8rem;
    font-size: clamp(1.45rem, 2vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    scroll-margin-top: 6rem;
  }

  .legal-body :global(h2:first-child),
  .legal-body :global(h1 + h2) {
    margin-top: 0;
  }

  .legal-body :global(h3) {
    margin: 1.8rem 0 0.5rem;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.25;
    scroll-margin-top: 6rem;
  }

  .legal-body :global(p),
  .legal-body :global(ul),
  .legal-body :global(ol) {
    margin: 0 0 1rem;
  }

  .legal-body :global(ul),
  .legal-body :global(ol) {
    padding-left: 1.3rem;
  }

  .legal-body :global(ul) {
    list-style: disc;
  }

  .legal-body :global(ol) {
    list-style: decimal;
  }

  .legal-body :global(li::marker) {
    color: #7c2a30;
  }

  .legal-body :global(li + li) {
    margin-top: 0.35rem;
  }

  .legal-body :global(a) {
    color: #7c2a30;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .legal-body :global(strong) {
    font-weight: 700;
  }

  /* Taules (inventari de cookies): desplaçament horitzontal propi a pantalles estretes. */
  .legal-body :global(table) {
    display: block;
    max-width: 100%;
    margin: 1.2rem 0 1.6rem;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.94rem;
    line-height: 1.4;
  }

  .legal-body :global(th),
  .legal-body :global(td) {
    padding: 0.6rem 0.8rem;
    border: 1px solid #d3d9d5;
    text-align: left;
    vertical-align: top;
  }

  .legal-body :global(th) {
    background: var(--surface-read-alt);
    font-weight: 700;
  }

  .legal-empty {
    padding: 1.5rem;
    border: 1px dashed #aab1ab;
    color: #4d5551;
  }

  @media (max-width: 860px) {
    .legal-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .legal-aside {
      position: static;
    }

    .legal-body {
      grid-column: 1;
    }

    /* A mòbil, l'índex és una llista plegada al començament: no ocupa la pantalla sencera. */
    .legal-aside {
      gap: 1.25rem;
    }

    h1 {
      font-size: min(var(--type-hero), calc((100vw - 2 * var(--page-gutter)) / (var(--chars) * 0.53)));
    }
  }
</style>
