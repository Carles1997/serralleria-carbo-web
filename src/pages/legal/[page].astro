---
// Pàgines legals (/legal/avis-legal/, /legal/privacitat/, /legal/cookies/). Fase 8, tasca 8.3.
// En el build de producció només es generen les que el contingut marca com a publicables
// (status: approved i sense publishReady: false); mentre els textos siguin pendents no hi ha cap
// pàgina legal publicada i el peu les mostra com a «pendent». En desenvolupament (astro dev) es
// generen totes, amb l'avís d'esborrany, per revisar la plantilla.
import { getCollection } from 'astro:content';
import LegalTemplate from '../../templates/LegalTemplate.astro';
import { defaultLocale } from '../../i18n/config';
import { useUi } from '../../i18n/ui';
import type { Page } from '../../i18n/pages';

export async function getStaticPaths() {
  const publishable = (page: Page) => page.data.status === 'approved' && page.data.publishReady !== false;
  const legal = (await getCollection('pages', ({ data }) => data.lang === defaultLocale && data.pageId.startsWith('legal-') && Boolean(data.route)))
    .filter((page) => import.meta.env.DEV || publishable(page));
  const labels = useUi(defaultLocale).footer.legal as Record<string, string>;
  // Mateix ordre que el peu: avís legal, privacitat, cookies.
  const order = Object.keys(labels);
  legal.sort((a, b) => order.indexOf(a.data.pageId) - order.indexOf(b.data.pageId));
  return legal.map((page) => {
    const route = page.data.route as string;
    const slug = route.replace(/^\/legal\//, '').replace(/\/$/, '');
    if (!slug || slug.includes('/')) throw new Error(`Ruta legal no admesa: ${route}`);
    const siblings = legal.map((other) => ({
      label: labels[other.data.pageId] ?? other.data.pageId,
      href: other.data.route as string,
      current: other.id === page.id,
    }));
    return { params: { page: slug }, props: { page, siblings } };
  });
}

const { page, siblings } = Astro.props;
---

<LegalTemplate page={page} siblings={siblings} />
