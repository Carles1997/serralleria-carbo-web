---
// Plantilla P (portada de Particulars). Composició: fases/fase-4/FASE4-mockups/particulars/
// amb identitat.css i revisio-client.css (vegeu particulars.css). Text i enllaços:
// content/{idioma}/particulars.md; casos: content/{idioma}/projects/. Etiquetes i
// titulars de la maqueta: i18n/ui.ts. Imatges sense llegendes (director, 28/09/2026).
// Bloc 1 del pla d'afinament (fases/fase-5/FASE5-pla-millora-integral.md): accés a Urgències a
// l'entrada i franja d'urgències just després; el primer paràgraf del contingut obre Serveis (sense
// secció d'introducció pròpia); l'àrea de treball s'integra al contacte; sense rètols numerats.
// Bloc 2: sense etiquetes que repeteixen el titular (branca, «Atenció directa», títols del contingut
// sobre l'H2, categories, peu dels casos); es mantenen el número i el tipus d'obra de cada cas.
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactBlock from '../components/ContactBlock.astro';
import Inlines from '../components/Inlines.astro';
import type { Page } from '../i18n/pages';
import { useUi } from '../i18n/ui';
import { company } from '../config/site';
import { links, one, paragraphs, parseInlines, parseMarkdown, sameText } from '../lib/markdown';
import { projectPhotography, sitePhotography, type ProjectPhotoId } from '../config/photography';
import './mockup-base.css';
import './particulars.css';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const locale = page.data.lang;
const ui = useUi(locale);
const t = ui.particulars;

// Estructura de particulars.md: H1, dos paràgrafs d'entrada i cinc seccions H2;
// la primera conté els quatre serveis en H3 i la segona és el pont cap a Industrial
// (reunió amb el client, 03/10/2026: els mateixos productes, en diverses unitats o en sèrie).
const doc = parseMarkdown(page.body ?? '');
if (doc.sections.length !== 5) throw new Error(`particulars.md ha de tenir 5 seccions H2; en té ${doc.sections.length}.`);
const [help, series, works, area, contact] = doc.sections;

if (t.hero.title.join(' ') !== doc.title) {
  throw new Error(`El titular compost («${t.hero.title.join(' ')}») no coincideix amb la H1 de particulars.md.`);
}
// Un paràgraf d'entrada, que obre la secció de serveis (el peu de l'entrada es va retirar el
// 29/09/2026). Titulars de secció: text del contingut, repartit en línies a i18n/ui.ts.
const introWorks = one(paragraphs(doc.intro), "un paràgraf d'entrada a particulars.md");
sameText(t.services.heading, help.heading, 'particulars.md');
sameText(t.projects.heading, works.heading, 'particulars.md');
sameText(t.contactHeading, contact.heading, 'particulars.md');

// Carros industrials passen a Industrial i entren les reparacions (03/10/2026).
const artVariants = ['doors', 'structures', 'furniture', 'repairs'];
if (help.subsections.length !== artVariants.length) {
  throw new Error(`«${help.heading}» ha de tenir ${artVariants.length} serveis H3; en té ${help.subsections.length}.`);
}
const services = help.subsections.map((service, index) => ({
  title: service.heading,
  text: one(paragraphs(service.blocks), `un paràgraf al servei «${service.heading}»`),
  links: links(service.blocks),
  art: artVariants[index],
  image: sitePhotography.particulars.serviceCards[artVariants[index] as keyof typeof sitePhotography.particulars.serviceCards],
}));
if (services.some((service) => !service.links.length)) throw new Error('Cada servei necessita almenys un enllaç.');

const seriesText = one(paragraphs(series.blocks), `un paràgraf a «${series.heading}»`);
const seriesLink = one(links(series.blocks), `un enllaç a «${series.heading}»`);
const worksText = one(paragraphs(works.blocks), `un paràgraf a «${works.heading}»`);
const worksLink = one(links(works.blocks), `un enllaç a «${works.heading}»`);
const areaText = one(paragraphs(area.blocks), `un paràgraf a «${area.heading}»`);
const contactText = paragraphs(contact.blocks)[0];
const contactLink = one(links(contact.blocks), 'un enllaç a la secció de contacte');
if (!contactText) throw new Error('La secció de contacte necessita un paràgraf.');

// Casos destacats: han d'existir i ser de la branca Particulars.
const chapters = await Promise.all(
  t.projects.featured.map(async (id, index) => {
    const project = await getEntry('projects', `${locale}/projects/${id}`);
    if (!project || project.data.branch !== 'particulars') throw new Error(`El cas «${id}» no existeix a Particulars.`);
    const serviceHref = `/particulars/${project.data.category}/`;
    const service = t.nav.find((item) => item.href === serviceHref);
    if (!service) throw new Error(`No hi ha ruta de servei per a la categoria «${project.data.category}».`);
    return {
      number: index + 1,
      title: project.data.title,
      text: parseInlines((project.body ?? '').trim().replace(/\s+/g, ' ')),
      overline: ui.projectContexts[id],
      service,
      photo: projectPhotography[id as ProjectPhotoId],
    };
  }),
);
const total = String(chapters.length).padStart(2, '0');
const pad = (value: number) => String(value).padStart(2, '0');
const fit = (...lines: string[]) => `--chars:${Math.max(...lines.join(' ').split(/\s+/).map((word) => word.length))}`;
---

<BaseLayout page={page}>
  <SiteHeader ui={ui} homeHref="/" nav={t.nav} mobileExtra={t.mobileExtra} collapse="wide" />

  <main id="contingut" class="particulars-page">
    <section class="p-hero" aria-labelledby="p-title" data-surface="dark">
      <div class="p-hero-image" aria-hidden="true">
        <Picture src={sitePhotography.particulars.hero} alt="" widths={[640, 960, 1280, 1672]} sizes="100vw" formats={['avif', 'webp']} fallbackFormat="jpg" priority />
      </div>
      <div class="p-hero-copy section-shell">
        <div class="p-hero-top enter">
          <a href={t.hero.otherBranch.href}>{t.hero.otherBranch.label} <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
        <div class="p-hero-main">
          <h1 id="p-title" style={`--chars:${t.hero.title[1].length}`}>
            <span class="enter" style="--i:1">{t.hero.title[0]} </span><em class="enter" style="--i:2">{t.hero.title[1]} </em><small class="enter" style="--i:3">{t.hero.title[2]}</small>
          </h1>
        </div>
      </div>
    </section>

    <section class="p-urgent surface-brand-grey" id="urgencies" aria-labelledby="p-urgent-title" data-surface="light">
      <div class="section-shell p-urgent-inner">
        <div data-reveal>
          <h2 id="p-urgent-title">{t.urgent.heading}</h2>
          <p>{t.urgent.text}</p>
        </div>
        <a href={t.urgent.form.href} data-reveal style="--i:1">{t.urgent.form.label} <span class="arrow" aria-hidden="true">↗</span></a>
        <a href={company.phone.href} data-reveal style="--i:2">{ui.contact.call(company.phone.display)} <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="p-services" id="serveis" aria-labelledby="p-services-title" data-surface="light">
      <div class="section-shell">
        <div class="section-lead">
          <h2 id="p-services-title" data-reveal style={fit(...t.services.heading)}>{t.services.heading[0]}<br />{' '}{t.services.heading[1]}</h2>
          <p data-reveal style="--i:2"><Inlines inlines={introWorks} /></p>
        </div>
        <div class="p-service-grid">
          {
            services.map((service, index) => (
              <article class={`p-service p-service-${service.art}`} data-reveal style={`--i:${index}`}>
                <div class={`p-service-art p-service-art-${service.art}`} aria-hidden="true">
                  <Picture src={service.image} alt="" widths={[240, 400, 640, 960]} sizes="(max-width: 350px) 100vw, 50vw" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" decoding="async" />
                </div>
                <div class="p-service-copy">
                  <h3>{service.title}</h3>
                  <p><Inlines inlines={service.text} /></p>
                  <p class="p-service-actions">
                    {service.links.map((link) => (
                      <a href={link.href}>
                        {link.label} <span class="arrow" aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="p-series" aria-labelledby="p-series-title" data-surface="dark">
      <div class="section-shell p-series-inner">
        <div data-reveal>
          <h2 id="p-series-title">{series.heading}</h2>
          <p><Inlines inlines={seriesText} /></p>
        </div>
        <a href={seriesLink.href} data-reveal style="--i:1">{seriesLink.label} <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="p-projects surface-brand-grey" id="projectes" aria-labelledby="p-projects-title" data-surface="light">
      <div class="section-shell">
        <div class="section-lead">
          <h2 id="p-projects-title" data-reveal style={fit(...t.projects.heading)}>{t.projects.heading[0]}<br />{' '}{t.projects.heading[1]}</h2>
          <p data-reveal style="--i:2"><Inlines inlines={worksText} /></p>
        </div>
      </div>
      <div class="p-project-story" data-story>
        <div class="p-story-stage" aria-hidden="true">
          {chapters.map((chapter, index) => (
            <span class:list={['p-story-frame', { 'is-active': index === 0 }]} data-story-image={index}>
              <Picture src={chapter.photo.stage} alt="" widths={[480, 720, 960, 1200]} sizes="(max-width: 760px) 100vw, 48vw" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" decoding="async" />
            </span>
          ))}
          <div class="p-story-stage-shade"></div>
          <div class="p-story-progress"><span data-story-progress style={`scale:${1 / chapters.length} 1`}></span></div>
        </div>
        <div class="p-story-chapters" data-surface="light">
          {
            chapters.map((chapter) => (
              <article class="p-story-chapter" data-story-chapter={chapter.number}>
                <div class="p-story-chapter-top">
                  <span>
                    {pad(chapter.number)} / {total}
                  </span>
                  <a href={chapter.service.href}>{chapter.service.label}</a>
                </div>
                <div data-reveal>
                  <span class="p-story-overline">{chapter.overline}</span>
                  <h3>{chapter.title}</h3>
                  <p>
                    <Inlines inlines={chapter.text} />
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
      <div class="section-shell p-story-outro">
        <div class="p-story-outro-actions" data-reveal>
          <a class="p-story-all" href={worksLink.href}>{worksLink.label} <span class="arrow" aria-hidden="true">↗</span></a>
          <a class="underlined-link" href="#contacte">{t.projects.talk} <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <ContactBlock ui={ui} heading={t.contactHeading} text={contactText} form={contactLink} note={{ label: area.heading, text: areaText }} />
  </main>

  <SiteFooter ui={ui} locale={locale} contactHref={contactLink.href} />
</BaseLayout>

<script>
  import '../scripts/story';
</script>
