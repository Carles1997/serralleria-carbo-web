---
// Peu comú de Fase 1: Contacte · Avís legal · Privacitat · Cookies · ©.
// Una pàgina legal només s'enllaça quan el contingut la marca com a publicable.
import { company } from '../config/site';
import BrandLogo from './BrandLogo.astro';
import type { Locale } from '../i18n/config';
import { getPage, isLegalVisible } from '../i18n/pages';
import type { UiStrings } from '../i18n/ui';

interface Props {
  ui: UiStrings;
  locale: Locale;
  contactHref: string;
  variant?: 'serralleria' | 'industrial';
}

const { ui, locale, contactHref, variant = 'serralleria' } = Astro.props;

const legal = await Promise.all(
  (Object.entries(ui.footer.legal) as [string, string][]).map(async ([pageId, label]) => {
    const page = await getPage(pageId, locale);
    return { label, href: isLegalVisible(page) ? page.data.route : undefined };
  }),
);
---

<footer class:list={['site-footer', `site-footer-${variant}`]} data-surface={variant === 'industrial' ? 'dark' : 'light'}>
  <div class="footer-inner">
    <div class="footer-brand">
      <BrandLogo variant={variant} place="footer" /><small>{ui.brand.tagline}</small>
    </div>
    <ul class="footer-links">
      <li><a href={contactHref}>{ui.footer.contact}</a></li>
      {
        legal.map(({ label, href }) => (
          <li>{href ? <a href={href}>{label}</a> : <span>{label} <small>({ui.footer.pending})</small></span>}</li>
        ))
      }
      <li><span>© {company.legalName}</span></li>
    </ul>
    <a class="back-top" href="#inici">{ui.footer.backTop} <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  /* Peu compacte (refinament del director, 06/10/2026): la meitat de padding i sense alçada mínima.
     Clar a Home, Particulars i Contacte; grafit mitjà a Industrial. */
  .site-footer {
    --footer-muted: var(--ink-muted);
    border-top: 1px solid var(--line-on-light);
    background: var(--surface-grey);
    color: var(--ink);
  }

  .site-footer-industrial {
    --footer-muted: #c9d0ce;
    border-top-color: #6a7473;
    background: #3a4243;
    color: #f3f4f2;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    width: min(100%, 1600px);
    margin-inline: auto;
    padding: 1.1rem var(--page-gutter);
  }

  .footer-brand {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-brand small {
    margin-top: 0.5rem;
    color: var(--footer-muted);
    font-size: 0.83rem;
    line-height: 1.3;
    text-transform: none;
  }

  /* Enllaços en fila (també a mòbil, on fan salt de línia): cada un conserva 44 px de zona tàctil. */
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25rem;
    color: var(--footer-muted);
    font-size: 0.84rem;
  }

  .footer-links a,
  .footer-links span {
    display: flex;
    align-items: center;
    gap: 0.3em;
    min-height: var(--target-min);
  }

  .footer-links a {
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .back-top {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--target-min);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 520px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
