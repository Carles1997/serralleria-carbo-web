---
// Bloc final de contacte de les portades (maqueta Home de Fase 4). Destí principal
// al formulari unificat; canals directes amb les dades confirmades de config/site.
import Inlines from './Inlines.astro';
import { company, whatsappUrl } from '../config/site';
import type { Inline, Link } from '../lib/markdown';
import type { UiStrings } from '../i18n/ui';

interface Props {
  ui: UiStrings;
  /** Rètol sobre el titular. Les portades del pilot del Bloc 1 ja no en porten. */
  index?: string;
  /** Text del titular; una llista força els salts de línia de la maqueta. */
  heading: string | string[];
  /** Text de la secció de contacte del contingut, si en té. */
  text?: Inline[];
  form: Link;
  /** Informació complementària breu sota el text (p. ex. l'àrea de treball de Particulars). */
  note?: { label: string; text: Inline[] };
}

const { ui, index, heading, text, form, note } = Astro.props;
// Paraula més llarga del titular: a mòbil, l'H2 comú s'ajusta perquè hi càpiga.
const chars = Math.max(...[heading].flat().join(' ').split(/\s+/).map((word) => word.length));
---

<section class="contact" id="contacte" aria-labelledby="contact-title" data-surface="light">
  <div class="contact-inner">
    <div class="contact-copy">
      {index && <span class="contact-index" data-reveal>{index}</span>}
      <h2 id="contact-title" data-reveal style={`--i:1;--chars:${chars}`}>
        {Array.isArray(heading) ? heading.join(' ') : heading}
      </h2>
      {text && <p data-reveal style="--i:2"><Inlines inlines={text} /></p>}
      {
        note && (
          <div class="contact-note" data-reveal style="--i:3">
            <h3>{note.label}</h3>
            <p><Inlines inlines={note.text} /></p>
          </div>
        )
      }
    </div>
    <div class="contact-actions">
      <a class="contact-primary" href={whatsappUrl(ui.contact.whatsappMessage)} target="_blank" rel="noopener noreferrer" data-reveal style="--i:2">
        {ui.contact.whatsapp} <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <a href={form.href} data-reveal style="--i:3">{form.label} <span class="arrow" aria-hidden="true">↗</span></a>
      <a href={company.phone.href} data-reveal style="--i:4">
        {ui.contact.call(company.phone.display)} <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <a href={`mailto:${company.email}`} data-reveal style="--i:5">{company.email} <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  /* Tancament compacte (refinament del director, 06/10/2026): blanc trencat, titular mitjà, text
     curt i accions clares. El bordeus queda per a l'acció principal, no com a fons gegant. */
  .contact {
    padding-block: clamp(1.75rem, 1.2rem + 1.5vw, 2.5rem);
    border-top: 1px solid var(--line-on-light);
    background: var(--surface-paper);
    color: var(--ink);
  }

  .contact-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 26rem);
    align-items: center;
    gap: 1.5rem clamp(2rem, 5vw, 6rem);
    width: min(100%, 1600px);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .contact-index {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--ink-muted);
    font-size: var(--type-meta);
    font-weight: 700;
    letter-spacing: var(--tracking-meta);
    line-height: 1.25;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.5rem, 1rem + 1.8vw, 2.5rem);
    font-weight: 700;
    letter-spacing: var(--display-tracking);
    line-height: var(--display-leading);
    text-transform: uppercase;
    text-wrap: balance;
  }

  p {
    max-width: 60ch;
    margin-top: 0.75rem;
    color: var(--ink-muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .contact-note {
    max-width: 60ch;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line-on-light);
  }

  .contact-note h3 {
    color: var(--ink);
    font-size: var(--type-meta);
    font-weight: 700;
    letter-spacing: var(--tracking-meta);
    line-height: 1.3;
    text-transform: uppercase;
  }

  .contact-note p {
    margin-top: 0.35rem;
    font-size: 0.95rem;
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
  }

  .contact-actions a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 48px;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line-on-light);
    font-weight: 700;
    transition: scale 160ms var(--ease-out-strong), color var(--motion-fast) ease;
  }

  .contact-actions a:active {
    scale: 0.98;
  }

  .arrow {
    display: inline-block;
    color: var(--action);
    font-size: 1.1rem;
    font-weight: 400;
  }

  .contact-actions .contact-primary {
    margin-bottom: 0.35rem;
    padding: 0.6rem 1rem;
    border: 0;
    background: var(--action);
    color: var(--palette-white);
  }

  .contact-actions .contact-primary .arrow {
    color: var(--palette-white);
  }

  @media (hover: hover) and (pointer: fine) {
    .arrow {
      transition: translate 220ms var(--ease-out-strong);
    }

    .contact-actions a:hover .arrow {
      translate: 3px -3px;
    }

    .contact-actions a:not(.contact-primary):hover {
      color: var(--action);
    }

    .contact-actions .contact-primary:hover {
      background: var(--action-hover);
    }
  }

  @media (max-width: 860px) {
    .contact-inner {
      grid-template-columns: 1fr;
    }

    h2 {
      font-size: min(clamp(1.5rem, 1rem + 1.8vw, 2.5rem), calc((100vw - 2 * var(--page-gutter)) / (var(--chars) * 0.6)));
    }
  }

  @media (max-width: 520px) {
    .contact-actions a {
      overflow-wrap: anywhere;
    }
  }
</style>
