---
// Plantilla C (contacte compartit). Redisseny del director (06/10/2026,
// fases/fase-7/FASE7-brief-refinament-global-i-contacte.md, referència
// fases/fase-7/referencies/contacte-referencia-client-2026-10-06.png): una sola composició clara
// amb la informació de contacte a l'esquerra i el formulari a la dreta, un únic H1 i sense
// introducció ni columna que repeteixi el camí triat. A mòbil: H1, accessos directes, formulari i,
// després, horari i adreça.
// Text: content/{idioma}/contacte.md (H1, horari i «On som»); telèfons, correu i adreça de
// src/config/site.ts; etiquetes del formulari: i18n/ui.ts (content/ca/ui.md).
// Formulari real (Fase 8, 8.5; fases/fase-8/FASE8-formulari-real-pla.md): envia a la funció
// /api/contacte, que valida al servidor. Funciona amb JavaScript (fetch) i sense (enviament nadiu i
// resposta HTML). Mentre la funció estigui en mode de demostració no envia res i l'avís es manté.
// Branques sense JavaScript: els camps de les dues branques surten actius a l'HTML i el CSS
// (contact.css, :has) mostra només els de la branca marcada; la funció només llegeix els de la
// branca triada. Amb JavaScript, a més, la branca inactiva es desactiva i no s'envia.
// Els textos que depenen de la branca (etiqueta i ajuda de l'adjunt, desplegable de dades i ajuda de
// la descripció) surten en les dues variants aprovades de ui.ts i el CSS mostra la de la branca.
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Inlines from '../components/Inlines.astro';
import type { Page } from '../i18n/pages';
import { useUi } from '../i18n/ui';
import { company, whatsappUrl } from '../config/site';
import { labelledItem, listItems, one, paragraphs, parseInlines, parseMarkdown } from '../lib/markdown';
import { getPage, isLegalVisible } from '../i18n/pages';
import { ACCEPT_ATTRIBUTE, HONEYPOT_FIELD, INDUSTRIAL_PRODUCTS, MAX_ATTACHMENT_BYTES, PARTICULAR_SERVICES } from '../lib/contact/config';
import { clientMessages, contactMessages } from '../lib/contact/messages';
import './mockup-base.css';
import './contact.css';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const { lang: locale, route } = page.data;
const ui = useUi(locale);
const t = ui.contactPage;
const f = t.form;

// Estructura de contacte.md: H1 i dues seccions H2, horari (dues línies) i «On som».
const doc = parseMarkdown(page.body ?? '');
if (doc.sections.length !== 2) throw new Error(`contacte.md ha de tenir 2 seccions H2; en té ${doc.sections.length}.`);
if (paragraphs(doc.intro).length) throw new Error('contacte.md no porta introducció: la pàgina obre directament amb les dades i el formulari.');
const [hours, place] = doc.sections;
if (place.heading !== t.place.heading) throw new Error(`El H2 «${place.heading}» de contacte.md ha de ser «${t.place.heading}».`);
const hoursRows = listItems(hours.blocks).map(labelledItem);
if (hoursRows.length !== 2) throw new Error(`«${hours.heading}» ha de tenir dues línies; en té ${hoursRows.length}.`);
const area = one(paragraphs(place.blocks), `un paràgraf a «${place.heading}»`);

// Informació de privacitat del formulari (Fase 8, tasca 8.4): text de l'advocat a
// content/{idioma}/legal-formulari.md. Només es mostra quan està aprovat; fins aleshores, l'avís del
// formulari diu que s'incorporarà abans d'activar-lo. La casella apareix només si consent: true.
const privacyPage = await getPage('legal-formulari', locale);
const privacyReady = isLegalVisible(privacyPage);
if (privacyPage.data.status === 'approved' && (privacyPage.body ?? '').includes('[PENDENT')) {
  throw new Error('legal-formulari.md està aprovat però encara té dades «[PENDENT: …]».');
}
const privacy = privacyReady ? parseMarkdown(privacyPage.body ?? '') : undefined;
// Caselles del text de l'advocat (06/10/2026): acceptació obligatòria de la política de privacitat i,
// voluntària i desmarcada, la de comunicacions comercials amb la nota per revocar-la.
const consentLabel = privacyReady && privacyPage.data.consent && privacyPage.data.consentLabel ? parseInlines(privacyPage.data.consentLabel) : undefined;
const marketingLabel = privacyReady && privacyPage.data.marketingLabel ? parseInlines(privacyPage.data.marketingLabel) : undefined;
const marketingNote = privacyReady && privacyPage.data.marketingNote ? parseInlines(privacyPage.data.marketingNote) : undefined;

const whatsapp = whatsappUrl(ui.contact.whatsappMessage);

// La funció valida amb src/lib/contact/: els desplegables, les etiquetes i la ruta han de coincidir.
const formLocale = locale === 'es' ? 'es' : 'ca';
const server = contactMessages[formLocale];
const sameList = (options: readonly { value: string; label: string }[], allowed: Record<string, string>, name: string) => {
  if (options.map((option) => option.value).join() !== Object.keys(allowed).join()) throw new Error(`Els valors de ${name} (ui.ts) no coincideixen amb src/lib/contact/config.ts.`);
  if (formLocale === 'ca' && options.some((option) => option.label !== allowed[option.value])) throw new Error(`Les etiquetes de ${name} (ui.ts) no coincideixen amb les del correu (src/lib/contact/config.ts).`);
};
sameList(f.fields.services, PARTICULAR_SERVICES, 'services');
sameList(f.fields.productionServices, INDUSTRIAL_PRODUCTS, 'productionServices');
for (const field of ['nom', 'empresa', 'correu', 'telefon', 'ubicacio', 'descripcio', 'unitats', 'material', 'termini', 'sector'] as const) {
  if (server.fieldLabels[field] !== f.fields[field]) throw new Error(`L'etiqueta «${f.fields[field]}» (ui.ts) no coincideix amb src/lib/contact/messages.ts.`);
}
if (server.contactPath !== ui.routes.contact) throw new Error(`La ruta de contacte de messages.ts (${server.contactPath}) no és ${ui.routes.contact}.`);
const fileHint = (help: string) => `${help} ${server.fileHint}`;
---

<BaseLayout page={page}>
  <SiteHeader ui={ui} page={page} homeHref={ui.routes.home} nav={t.nav} current={route} />

  <main id="contingut" class="contact-page">
    <section class="contact-main" aria-labelledby="contact-title" data-surface="light">
      <div class="section-shell contact-layout">
        <h1 id="contact-title" class="contact-title enter">{doc.title}</h1>

        <dl class="contact-info contact-info-direct enter" style="--i:1" aria-label={t.info.label}>
          <div>
            <dt>{t.info.phone}</dt>
            <dd>
              <a class="contact-phone" href={company.phone.href}>{company.phone.display}</a>
              <p class="contact-phone-hours">{hoursRows[0].value}: {hoursRows[0].label}</p>
            </dd>
          </div>
          <div>
            <dt>{t.info.whatsapp}</dt>
            <dd><a href={whatsapp} target="_blank" rel="noopener noreferrer">{ui.contact.whatsapp} <span class="arrow" aria-hidden="true">↗</span></a></dd>
          </div>
          <div>
            <dt>{t.info.email}</dt>
            <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
          </div>
        </dl>

        <dl class="contact-info contact-info-place enter" style="--i:2">
          <div>
            <dt>{hours.heading}</dt>
            <dd>
              <ul class="contact-hours">
                {hoursRows.map((row) => <li><strong>{row.value}:</strong> {row.label}</li>)}
              </ul>
            </dd>
          </div>
          <div>
            <dt>{t.info.address}</dt>
            <dd>
              <address>{company.address[0]}<br />{company.postalAddress.postalCode} {company.postalAddress.locality}</address>
              <a class="contact-map-link" href="#on-som">{t.info.map} <span class="arrow" aria-hidden="true">↘</span></a>
            </dd>
          </div>
          <div>
            <dt>{t.info.landline}</dt>
            <dd><a href={company.landline.href}>{company.landline.display}</a></dd>
          </div>
        </dl>

        <div class="contact-form-panel enter" style="--i:2">
          <form
            id="contact-form"
            method="post"
            action={`/api/contacte?idioma=${formLocale}`}
            enctype="multipart/form-data"
            novalidate
            aria-label={f.label}
            data-contact-form
            data-errors={JSON.stringify(f.errors)}
            data-messages={JSON.stringify(clientMessages(formLocale))}
            data-max-bytes={MAX_ATTACHMENT_BYTES}
            data-industrial-path={ui.routes.industrial}
          >
            <input type="hidden" name="idioma" value={formLocale} />
            <input type="hidden" name="origen" value={route ?? ui.routes.contact} />
            <input type="hidden" name="ref" value="" data-ref />
            <input type="hidden" name="temps" value="" data-elapsed />
            <div class="form-trap" aria-hidden="true">
              <label for={HONEYPOT_FIELD}>{server.honeypot}</label>
              <input id={HONEYPOT_FIELD} name={HONEYPOT_FIELD} type="text" tabindex="-1" autocomplete="off" />
            </div>
            <div class="form-demo" role="note" id="form-pending">
              <strong>{f.demo}</strong>
              <p>{f.pending}{!privacy && ` ${f.pendingPrivacy}`}</p>
            </div>
            <fieldset class="branch-picker">
              <legend>{f.branch.legend} <span aria-hidden="true">*</span></legend>
              <div class="branch-options">
                {
                  (['particular', 'empresa'] as const).map((branch) => (
                    <label class="branch-option">
                      <input type="radio" name="tipus" value={branch} checked={branch === 'particular'} />
                      <span>
                        <strong>{f.branch[branch].label}</strong> <small>· {f.branch[branch].detail}</small>
                      </span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <div class="field-grid">
              <div class="field field-name">
                <label for="nom">{f.fields.nom} <span aria-hidden="true">*</span></label>
                <input id="nom" name="nom" autocomplete="name" required />
                <p class="field-error" id="nom-error" hidden></p>
              </div>
              <fieldset class="branch-fields field field-company" data-branch="empresa">
                <label for="empresa">{f.fields.empresa}</label>
                <input id="empresa" name="empresa" autocomplete="organization" />
              </fieldset>
              <div class="field">
                <label for="correu">{f.fields.correu} <span aria-hidden="true">*</span></label>
                <input id="correu" name="correu" type="email" inputmode="email" autocomplete="email" required />
                <p class="field-error" id="correu-error" hidden></p>
              </div>
              <div class="field">
                <label for="telefon">{f.fields.telefon}</label>
                <input id="telefon" name="telefon" type="tel" inputmode="tel" autocomplete="tel" />
                <p class="field-error" id="telefon-error" hidden></p>
              </div>

              <fieldset class="branch-fields field field-full" data-branch="particular">
                <label for="servei">{f.fields.servei} <span aria-hidden="true">*</span></label>
                <select id="servei" name="servei" required>
                  <option value="">{f.fields.serveiPlaceholder}</option>
                  {f.fields.services.map((service) => <option value={service.value}>{service.label}</option>)}
                </select>
                <p class="field-error" id="servei-error" hidden></p>
              </fieldset>
              <fieldset class="branch-fields field field-full" data-branch="empresa">
                <label for="servei-empresa">{f.fields.produccio}</label>
                <select id="servei-empresa" name="producte">
                  <option value="">{f.fields.produccioPlaceholder}</option>
                  {f.fields.productionServices.map((service) => <option value={service.value}>{service.label}</option>)}
                </select>
                <p class="field-error" id="servei-empresa-error" hidden></p>
              </fieldset>

              <div class="field field-full">
                <label for="descripcio">{f.fields.descripcio} <span aria-hidden="true">*</span></label>
                <div class="description-box">
                  <!-- Amb JavaScript, el text d'ajuda és el placeholder de la branca (contact-form.ts). Sense
                       JavaScript, el CSS mostra aquesta superposició, amb la variant de la branca marcada. -->
                  <textarea
                    id="descripcio"
                    name="descripcio"
                    rows="4"
                    required
                    placeholder=" "
                    data-placeholder-particular={f.fields.descripcioPlaceholder.particular}
                    data-placeholder-empresa={f.fields.descripcioPlaceholder.empresa}
                  ></textarea>
                  <span class="description-hint" aria-hidden="true"
                    ><span data-branch-text="particular">{f.fields.descripcioPlaceholder.particular}</span><span data-branch-text="empresa"
                      >{f.fields.descripcioPlaceholder.empresa}</span
                    ></span
                  >
                </div>
                <p class="field-error" id="descripcio-error" hidden></p>
              </div>

              <div class="field field-full upload-area" data-upload>
                <span class="upload-text">
                  <label for="adjunt"><span data-branch-text="particular">{f.upload.particular.label}</span><span data-branch-text="empresa">{f.upload.empresa.label}</span></label>
                  <span id="upload-help"><span data-branch-text="particular">{fileHint(f.upload.particular.help)}</span><span data-branch-text="empresa">{fileHint(f.upload.empresa.help)}</span></span>
                </span>
                <span class="upload-control">
                  <input id="adjunt" name="adjunt" type="file" accept={ACCEPT_ATTRIBUTE} aria-describedby="upload-help file-name" />
                  <label for="adjunt" class="upload-button" aria-hidden="true">{f.upload.choose}</label>
                  <span class="file-name" id="file-name" aria-live="polite">{f.upload.none}</span>
                </span>
                <p class="field-error" id="adjunt-error" hidden></p>
              </div>

              <details class="field-full form-extra">
                <summary><span data-branch-text="particular">{f.extra.particular}</span><span data-branch-text="empresa">{f.extra.empresa}</span></summary>
                <div class="field-grid form-extra-grid">
                  <div class="field">
                    <label for="ubicacio">{f.fields.ubicacio}</label>
                    <input id="ubicacio" name="ubicacio" autocomplete="address-level2" />
                  </div>
                  <fieldset class="branch-fields field-subgrid" data-branch="empresa">
                    <div class="field"><label for="unitats">{f.fields.unitats}</label><input id="unitats" name="unitats" inputmode="numeric" /></div>
                    <div class="field"><label for="material">{f.fields.material}</label><input id="material" name="material" /></div>
                    <div class="field"><label for="termini">{f.fields.termini}</label><input id="termini" name="termini" /></div>
                    <div class="field"><label for="sector">{f.fields.sector}</label><input id="sector" name="sector" autocomplete="off" /></div>
                  </fieldset>
                </div>
              </details>
            </div>

            {
              privacy && (
                <div class="form-privacy" id="form-privacy">
                  {consentLabel && (
                    <div class="field-consent">
                      <label for="consentiment">
                        <input id="consentiment" name="consentiment" type="checkbox" required />
                        <span>
                          <Inlines inlines={consentLabel} /> <span aria-hidden="true">*</span>
                        </span>
                      </label>
                      <p class="field-error" id="consentiment-error" hidden></p>
                    </div>
                  )}
                  <div class="form-privacy-info">
                    <p class="form-privacy-title">{privacy.title}</p>
                    {privacy.intro.map((block) =>
                      block.type === 'paragraph' ? (
                        <p>
                          <Inlines inlines={block.inlines} />
                        </p>
                      ) : (
                        <ul>
                          {block.items.map((item) => (
                            <li>
                              <Inlines inlines={item} />
                            </li>
                          ))}
                        </ul>
                      ),
                    )}
                  </div>
                  {marketingLabel && (
                    <div class="field-consent">
                      <label for="comunicacions">
                        <input id="comunicacions" name="comunicacions" type="checkbox" aria-describedby={marketingNote ? 'comunicacions-nota' : undefined} />
                        <span>
                          <Inlines inlines={marketingLabel} />
                        </span>
                      </label>
                      {marketingNote && (
                        <p class="form-privacy-note" id="comunicacions-nota">
                          <Inlines inlines={marketingNote} />
                        </p>
                      )}
                    </div>
                  )}
                </div>
              )
            }

            <div class="form-finish">
              <button type="submit" data-submit aria-describedby="form-pending">{f.submit} <span class="arrow" aria-hidden="true">↗</span></button>
            </div>
            <p id="form-status" class="form-status" role="status" tabindex="-1" hidden></p>
          </form>
        </div>
      </div>
    </section>

    <section class="contact-place" id="on-som" aria-labelledby="place-title" data-surface="light">
      <div class="section-shell place-grid">
        <div class="place-info">
          <h2 id="place-title">{place.heading}</h2>
          <address>{company.address[0]} · {company.address[1]}</address>
          <p><Inlines inlines={area} /></p>
          <a href={company.mapUrl} target="_blank" rel="noopener noreferrer">{t.place.map} <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
        <div class="place-map" data-map data-src={company.mapEmbedUrl} data-title={t.place.mapTitle}>
          <div class="place-map-facade">
            <span class="place-map-pin" aria-hidden="true"></span>
            <div class="place-map-enhanced" hidden data-map-enhanced>
              <button type="button" class="place-map-load" data-map-load>{t.place.mapLoad} <span class="arrow" aria-hidden="true">↗</span></button>
              <p class="place-map-note">{t.place.mapNote}</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <StructuredData />
  <SiteFooter ui={ui} locale={locale} contactHref={route ?? ui.routes.contact} />
</BaseLayout>

<script>
  import '../scripts/contact-form';
  import '../scripts/place-map';
</script>
