---
// Plantilla H (Home). Composició: fases/fase-4/FASE4-mockups/home/ amb
// revisio-client.css i els ajustos del director de projecte del 27/09/2026.
// Text: content/{idioma}/home.md, llegit per seccions (revisió editorial del 30/09/2026: el text
// visible és el del contingut). Les etiquetes de maqueta validades (i18n/ui.ts) completen la composició.
// Imatges: fotografies dels projectes i imatges de servei, sense llegendes (director, 28/09/2026).
// Moviment: styles/motion.css i scripts/motion.ts; tot és llegible sense JS i amb moviment reduït.
// Bloc 1 del pla d'afinament (fases/fase-5/FASE5-pla-millora-integral.md): sense rètols numerats
// decoratius ni etiquetes que repeteixen el nom de la rajola; el mosaic de serveis no torna a
// presentar les branques del doble accés.
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactBlock from '../components/ContactBlock.astro';
import StructuredData from '../components/StructuredData.astro';
import Inlines from '../components/Inlines.astro';
import type { Page } from '../i18n/pages';
import { useUi } from '../i18n/ui';
import { sitePhotography } from '../config/photography';
import { labelledItem, links, listItems, one, paragraphs, parseMarkdown, sameText } from '../lib/markdown';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const locale = page.data.lang;
const ui = useUi(locale);
const t = ui.home;

// Estructura de home.md: H1 + entrada i set seccions H2, en aquest ordre. «Com triar el camí»
// explica el criteri entre les dues branques (indicació del director després de la reunió amb el
// client, 03/10/2026: fases/fase-7/FASE7-proposta-dos-camins.md, alternativa A).
const doc = parseMarkdown(page.body ?? '');
if (doc.sections.length !== 7) throw new Error(`home.md ha de tenir 7 seccions H2; en té ${doc.sections.length}.`);
const [particulars, industrial, guide, numbers, workshop, services, contact] = doc.sections;

const [titleMain, ...titleRest] = doc.title.split(',');
const titleWords = titleMain.trim().split(' ');
const titleSmall = titleRest.join(',').trim();

const particularsCopy = one(paragraphs(particulars.blocks), 'un paràgraf a la secció Particulars');
const particularsLink = one(links(particulars.blocks), 'un enllaç a la secció Particulars');
const [industrialSlogan, industrialScope] = paragraphs(industrial.blocks);
if (!industrialSlogan || !industrialScope) throw new Error("La secció Industrial necessita el missatge de marca i l'abast de la producció.");
const industrialLink = one(links(industrial.blocks), 'un enllaç a la secció Industrial');

// Criteri entre camins: un element per branca (Particulars, Industrial) i l'ajuda cap a Contacte.
const guideItems = listItems(guide.blocks).map(labelledItem);
if (guideItems.length !== 2) throw new Error(`«${guide.heading}» ha de tenir dos criteris; en té ${guideItems.length}.`);
const guideHelp = one(links(guide.blocks), `un enllaç d'ajuda a «${guide.heading}»`);
// Banda de decisió d'una línia a escriptori (director, 06/10/2026): pregunta curta i nom de la branca.
const guidePaths = [
  { question: guideItems[0].value, branch: guideItems[0].label, href: particularsLink.href, expected: particulars.heading },
  { question: guideItems[1].value, branch: guideItems[1].label, href: industrialLink.href, expected: industrial.heading },
];
const strayBranch = guidePaths.find((path) => path.branch !== path.expected);
if (strayBranch) throw new Error(`«${guide.heading}»: «${strayBranch.branch}» ha de ser el nom de la branca («${strayBranch.expected}»).`);

// Xifres: dada i etiqueta de home.md; ui.ts només hi afegeix el valor numèric per al comptador.
sameText(t.numbers.heading, numbers.heading, 'home.md');
const figures = listItems(numbers.blocks).map(labelledItem);
const numberItems = t.numbers.items.map((item) => {
  const figure = figures.find((entry) => entry.value === item.source);
  if (!figure) throw new Error(`La xifra «${item.source}» no consta a home.md.`);
  return { ...item, label: figure.label };
});
if (numberItems.length !== figures.length) throw new Error('Cada xifra de home.md necessita el seu valor a i18n/ui.ts.');

// El taller com a punt comú dels dos camins (director, 06/10/2026).
const workshopText = one(paragraphs(workshop.blocks), 'un paràgraf al taller');
// Sense enllaç: la pàgina d'empresa s'ha retirat (director, 06/10/2026); les zones de treball hi
// són la tercera línia.
const workshopRows = listItems(workshop.blocks).map(labelledItem);
if (workshopRows.length !== 3) throw new Error('El taller necessita tres línies: fabricació, muntatge i zones de treball.');
const workshopHeading = workshop.heading.split(/(?<=\.)\s+/).map((line) => line.replace(/\.$/, ''));

const servicesLead = one(paragraphs(services.blocks), 'un paràgraf a la secció de serveis');
const serviceLinks = links(services.blocks);
if (serviceLinks.length !== t.services.tiles.length) {
  throw new Error(`La secció de serveis ha de tenir ${t.services.tiles.length} enllaços; en té ${serviceLinks.length}.`);
}
const tiles = serviceLinks.map((link, index) => ({ ...link, ...t.services.tiles[index] }));
const [doorTile, structuresTile, furnitureTile, repairsTile, industrialTile] = tiles;

const contactText = one(paragraphs(contact.blocks), 'un paràgraf a la secció de contacte');
const contactLink = one(links(contact.blocks), 'un enllaç a la secció de contacte');

const pathSizes = '(max-width: 760px) 100vw, 50vw';
const fit = (...lines: string[]) => `--chars:${Math.max(...lines.join(' ').split(/\s+/).map((word) => word.length))}`;
const tileSizes = '(max-width: 760px) 50vw, (max-width: 1000px) 50vw, 25vw';
---

<BaseLayout page={page}>
  <SiteHeader ui={ui} homeHref={page.data.route ?? '/'} nav={t.nav} mobileExtra={t.mobileExtra} />

  <main id="contingut" class="home">
    <section class="hero-intro surface-brand-grey" aria-labelledby="home-title" data-surface="dark">
      <div class="hero-main shell">
        <h1 id="home-title">
          {
            titleWords.map((word, index) => (
              <span class="hero-line" style={`--i:${index}`}>
                {word}
                {index === titleWords.length - 1 && titleSmall && <span class="hero-stop">,</span>}{' '}
              </span>
            ))
          }
          {titleSmall && <small class="enter" style={`--i:${titleWords.length}`}>{titleSmall}</small>}
        </h1>
      </div>
    </section>

    <section class="paths surface-brand-grey" aria-label={t.paths.label} data-surface="dark">
      <div class="path-guide shell">
        <h2 id="path-guide-title" class="path-guide-title">{guide.heading}</h2>
        <ul class="path-guide-list">
          {
            guidePaths.map((path) => (
              <li>
                <a href={path.href}>
                  <span class="path-guide-question">{path.question}</span>
                  <strong class="path-guide-branch">
                    {path.branch} <span class="arrow" aria-hidden="true">↗</span>
                  </strong>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="path-guide-help">
          <a href={guideHelp.href}>{guideHelp.label} <span class="arrow" aria-hidden="true">↗</span></a>
        </p>
      </div>
      <div class="paths-grid">
        <a class="path path-particulars" href={particularsLink.href} data-reveal="clip">
          <Picture src={sitePhotography.home.particulars} alt="" widths={[640, 960, 1280, 1672]} sizes={pathSizes} formats={['avif', 'webp']} fallbackFormat="jpg" priority />
          <span class="path-shade" aria-hidden="true"></span>
          <span class="path-top">
            <span class="corner" aria-hidden="true"><span class="arrow">↗</span></span>
          </span>
          <span class="path-kicker">{t.paths.particulars.kicker}</span>
          <strong class="path-title">{particulars.heading}</strong>
          <span class="path-copy"><Inlines inlines={particularsCopy} /></span>
          <span class="path-action">{particularsLink.label} <span class="arrow" aria-hidden="true">↗</span></span>
        </a>
        <a class="path path-industrial" href={industrialLink.href} data-reveal="clip" style="--i:2">
          <Picture src={sitePhotography.home.industrial} alt="" widths={[640, 960, 1280, 1536]} sizes={pathSizes} formats={['avif', 'webp']} fallbackFormat="jpg" priority />
          <span class="path-shade" aria-hidden="true"></span>
          <span class="path-top">
            <span class="corner" aria-hidden="true"><span class="arrow">↗</span></span>
          </span>
          <span class="path-kicker">{t.paths.industrial.kicker}</span>
          <strong class="path-title">{industrial.heading}</strong>
          <span class="path-copy">
            <span class="path-slogan"><Inlines inlines={industrialSlogan} /></span>
            <span class="path-scope"><Inlines inlines={industrialScope} /></span>
          </span>
          <span class="path-action">{industrialLink.label} <span class="arrow" aria-hidden="true">↗</span></span>
        </a>
      </div>
    </section>

    <section class="numbers" aria-labelledby="numbers-title" data-surface="light">
      <div class="shell">
        <div class="section-lead">
          <h2 id="numbers-title" data-reveal style={fit(...t.numbers.heading)}>
            {t.numbers.heading.map((line, index) => (index ? [' ', <br />, line] : line))}
          </h2>
        </div>
        <ul class="number-grid" data-counters>
          {
            numberItems.map(({ value, unit, label }, index) => (
              <li class="number-item" data-reveal style={`--i:${index}`}>
                {/* Si l'etiqueta ja diu la dada sencera (6 furgonetes · 1 camió ploma), la xifra gran és
                    visual i l'etiqueta en fa de nom accessible complet (valoració editorial, 06/10/2026). */}
                <strong aria-hidden={label.includes(String(value)) ? 'true' : undefined}>
                  <span class="count" data-count={value} style={`--digits:${String(value).length}`} aria-hidden="true">
                    {value}
                  </span>
                  <span class="sr-only">{value}</span>
                  {unit && ' '}
                  {unit && <small>{unit}</small>}
                </strong>
                <span>{label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="company workshop" id="empresa" aria-labelledby="company-title" data-surface="light">
      <div class="company-image" data-reveal="clip">
        <Picture src={sitePhotography.home.company} alt="" widths={[480, 720, 960, 1200]} sizes="(max-width: 760px) 100vw, 58vw" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" decoding="async" />
      </div>
      <div class="company-content">
        <h2 id="company-title" data-reveal style={fit(workshop.heading)}>
          {workshopHeading.map((line, index) => (index ? [' ', <br />, line] : line))}
        </h2>
        <p class="workshop-text" data-reveal style="--i:1"><Inlines inlines={workshopText} /></p>
        <dl class="workshop-rows" data-reveal style="--i:2">
          {workshopRows.map((row) => <div><dt>{row.value}</dt><dd>{row.label}</dd></div>)}
        </dl>
      </div>
    </section>

    <section class="services surface-brand-grey" id="serveis" aria-labelledby="services-title" data-surface="dark">
      <div class="shell">
        <div class="section-lead services-lead">
          <h2 id="services-title" data-reveal style={fit(services.heading)}>{services.heading}</h2>
          <p data-reveal style="--i:2"><Inlines inlines={servicesLead} /></p>
        </div>
        <div class="offer-grid">
          <div class="offer-branch">
            <div class="offer-branch-heading" data-reveal>
              <span>{t.services.particulars.eyebrow}</span>
              <h3>{t.services.particulars.title}</h3>
            </div>
            <div class="service-tiles">
              <a class="tile tile-photo tile-doors" href={doorTile.href} data-reveal style="--i:1">
                <span class="tile-top"><span class="corner" aria-hidden="true"><span class="arrow">↗</span></span></span>
                <Picture src={sitePhotography.home.doorsTile} alt="" widths={[400, 800]} sizes={tileSizes} formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" decoding="async" />
                <span class="tile-shade" aria-hidden="true"></span>
                <span class="tile-bottom"><strong>{doorTile.label}</strong><span>{doorTile.detail}</span></span>
              </a>
              <a class="tile tile-photo tile-structures" href={structuresTile.href} data-reveal style="--i:2">
                <Picture src={sitePhotography.home.structuresTile} alt="" widths={[400, 800]} sizes={tileSizes} formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" decoding="async" />
                <span class="tile-shade" aria-hidden="true"></span>
                <span class="tile-top"><span class="corner" aria-hidden="true"><span class="arrow">↗</span></span></span>
                <span class="tile-bottom"><strong>{structuresTile.label}</strong><span>{structuresTile.detail}</span></span>
              </a>
              <a class="tile tile-photo tile-furniture" href={furnitureTile.href} data-reveal style="--i:3">
                <span class="tile-top"><span class="corner" aria-hidden="true"><span class="arrow">↗</span></span></span>
                <Picture src={sitePhotography.home.furnitureTile} alt="" widths={[400, 800]} sizes={tileSizes} formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" decoding="async" />
                <span class="tile-shade" aria-hidden="true"></span>
                <span class="tile-bottom"><strong>{furnitureTile.label}</strong><span>{furnitureTile.detail}</span></span>
              </a>
              <a class="tile tile-photo tile-repairs" href={repairsTile.href} data-reveal style="--i:4">
                <Picture src={sitePhotography.home.repairsTile} alt="" widths={[400, 800]} sizes={tileSizes} formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" decoding="async" />
                <span class="tile-shade" aria-hidden="true"></span>
                <span class="tile-top"><span class="corner" aria-hidden="true"><span class="arrow">↗</span></span></span>
                <span class="tile-bottom"><strong>{repairsTile.label}</strong><span>{repairsTile.detail}</span></span>
              </a>
            </div>
            <a class="offer-overview" href={particularsLink.href}>
              {t.services.particulars.overview} <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="offer-branch">
            <div class="offer-branch-heading" data-reveal style="--i:1">
              <span>{t.services.industrial.eyebrow}</span>
              <h3>{t.services.industrial.title}</h3>
            </div>
            <a class="tile tile-photo tile-industrial" href={industrialTile.href} data-reveal="clip" style="--i:2">
              <Picture src={sitePhotography.home.industrialTile} alt="" widths={[640, 960, 1280]} sizes="(max-width: 1000px) 100vw, 50vw" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" decoding="async" />
              <span class="tile-shade" aria-hidden="true"></span>
              <span class="tile-top"><span class="corner" aria-hidden="true"><span class="arrow">↗</span></span></span>
              <span class="industrial-content">
                <strong>{industrialTile.label}</strong>
                <span class="industrial-detail">{industrialTile.detail}</span>
                <span class="industrial-products">
                  {t.services.industrial.products.map((product) => <span>{product}</span>)}
                </span>
              </span>
            </a>
            <a class="offer-overview" href={industrialLink.href}>
              {t.services.industrial.overview} <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <ContactBlock ui={ui} heading={contact.heading} text={contactText} form={contactLink} />
  </main>

  <StructuredData />
  <SiteFooter ui={ui} locale={locale} contactHref={contactLink.href} tone="brand-grey" />
</BaseLayout>

<style>
  /* Home (plantilla H). Composició de fases/fase-4/FASE4-mockups/home/ amb revisio-client.css i els
     ajustos del director. Refinament global del 06/10/2026 (fases/fase-7/FASE7-brief-refinament-
     global-i-contacte.md): superfícies de gris clar i blanc trencat amb el bordeus del logo, titulars
     i espaiat més petits. Les fotografies conserven text blanc amb una ombra local moderada. Un sol
     bloc d'estils: les regles antigues de maqueta i d'afinament s'han consolidat aquí. */
  .shell {
    width: min(100%, 1600px);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  /* <picture> ocupa el mateix mòdul que la imatge; les <source> no són elements flex. */
  .home :global(picture) {
    position: absolute;
    z-index: -3;
    inset: 0;
  }

  .arrow {
    display: inline-block;
  }

  /* Entrada: només el titular de marca, en gris clar. */
  .hero-intro {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(1.75rem, 1.1rem + 2vw, 3rem) clamp(1.5rem, 1rem + 1.4vw, 2.25rem);
    background: var(--surface-grey);
    color: var(--ink);
  }

  /* Titular de marca a la mida de la maqueta validada (director, 06/10/2026: és l'únic titular que
     conserva l'escala anterior). */
  h1 {
    font-size: clamp(4.1rem, 7.1vw, 7.4rem);
    font-weight: 700;
    letter-spacing: -0.075em;
    /* Interlineat amb aire per a l'accent de «CARBÓ» (director, 06/10/2026). */
    line-height: 0.9;
    text-transform: uppercase;
  }

  h1 > span {
    display: block;
    white-space: nowrap;
  }

  .hero-stop {
    color: currentColor;
  }

  h1 small {
    display: block;
    margin-top: 1.75rem;
    color: var(--ink-muted);
    font-size: clamp(1.15rem, 1.7vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.15;
    text-transform: none;
  }

  /* Entrada del titular: cada línia puja des de darrere d'una màscara a la seva pròpia base, una
     després de l'altra; el subtítol arriba quan acaben. Només amb CSS i sense moviment reduït. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-line {
      animation: title-rise 900ms var(--ease-out-strong) calc(var(--i, 0) * 120ms + 60ms) backwards;
    }

    h1 small.enter {
      animation-delay: 360ms;
    }
  }

  /* Com triar el camí: una sola banda a escriptori; per sota de 1100 px les opcions s'apilen. */
  .paths {
    background: var(--surface-grey);
  }

  .path-guide {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem clamp(1.5rem, 2.4vw, 2.75rem);
    padding-block: 0.6rem;
    border-top: 1px solid var(--line-on-light);
    color: var(--ink);
  }

  .path-guide-title {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--type-meta);
    font-weight: 700;
    letter-spacing: var(--tracking-meta);
    line-height: 1.3;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .path-guide-list {
    display: contents;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .path-guide-list li {
    min-width: 0;
  }

  .path-guide-list a {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    min-height: 44px;
    padding-block: 0.35rem;
    white-space: nowrap;
  }

  .path-guide-question {
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .path-guide-branch {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-bottom: 0.1rem;
    border-bottom: 1px solid var(--line-strong-on-light);
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .path-guide-branch .arrow {
    color: var(--ink);
  }

  .path-guide-list a:hover .path-guide-branch,
  .path-guide-list a:focus-visible .path-guide-branch {
    color: var(--ink);
    border-bottom-color: currentColor;
  }

  .path-guide-help {
    margin: 0 0 0 auto;
  }

  .path-guide-help a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    color: var(--ink-muted);
    font-size: 0.88rem;
    text-decoration: underline;
    text-decoration-color: var(--line-strong-on-light);
    text-underline-offset: 0.25em;
    white-space: nowrap;
  }

  .path-guide-help a:hover,
  .path-guide-help a:focus-visible {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  /* Doble accés fotogràfic. Files fixes (capçalera, espai, etiqueta, títol, text i acció); en dues
     columnes, subgrid comparteix les files i els títols queden alineats. */
  .paths-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line-on-light);
  }

  .path {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr auto auto auto auto;
    justify-items: start;
    min-width: 0;
    min-height: clamp(340px, 30vw, 440px);
    overflow: hidden;
    padding: clamp(1.25rem, 2.4vw, 2.5rem);
    background: #3c4245;
    color: #fff;
  }

  .path :global(img),
  .tile-photo :global(img) {
    position: absolute;
    z-index: -3;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .path :global(img) {
    filter: grayscale(1);
  }

  .path-particulars :global(img) {
    object-position: 55% center;
    filter: saturate(.9) contrast(1.02);
  }

  .path-industrial :global(img) {
    object-position: 47% center;
  }

  /* Ombra concentrada darrere del text (baix) i molt suau a dalt, perquè la fotografia es reconegui. */
  .path-shade {
    position: absolute;
    z-index: -2;
    inset: 0;
    background: linear-gradient(180deg, rgb(9 10 12 / 0.32), rgb(9 10 12 / 0.04) 28%, rgb(9 10 12 / 0.3) 52%, rgb(9 10 12 / 0.86));
  }

  .path-top {
    position: relative;
    z-index: 2;
    display: flex;
    justify-self: stretch;
  }

  .corner {
    display: grid;
    flex: none;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.7);
    font-weight: 400;
    line-height: 1;
  }

  .path .corner {
    width: 44px;
    height: 44px;
    margin: -0.5rem -0.5rem 0 auto;
    font-size: 1.3rem;
  }

  .path-kicker {
    grid-row: 3;
    margin-bottom: 0.6rem;
    font-size: var(--type-meta);
    font-weight: 700;
    letter-spacing: var(--tracking-meta);
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.45);
    text-transform: uppercase;
  }

  .path-title {
    grid-row: 4;
    font-size: clamp(2.25rem, 1.4rem + 2.4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .path-copy {
    grid-row: 5;
    max-width: 44ch;
    margin-top: 0.9rem;
    font-size: clamp(1rem, 0.9rem + 0.35vw, 1.15rem);
    line-height: 1.4;
